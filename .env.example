# Copy to .env and set to your host user: id -u / id -g
UID=1000
GID=1000

# Network port the GigE camera is wired to (ip -br link); empty skips the
# setup. Without a DHCP server the camera takes a 169.254.x.x address, so the
# container gives this port one in the same range
CAMERA_IFACE=
CAMERA_HOST_IP=169.254.1.1/16
